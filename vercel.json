{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    { "source": "/", "destination": "/code-pad", "permanent": false },
    { "source": "/code-pad/", "destination": "/code-pad", "permanent": true }
  ],
  "rewrites": [
    { "source": "/code-pad", "destination": "/index.html" },
    { "source": "/code-pad/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(code-pad/)?sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/code-pad" }
      ]
    },
    {
      "source": "/(code-pad/)?manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
